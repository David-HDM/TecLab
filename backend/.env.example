# PostgreSQL al que se conecta el backend Express.
DATABASE_URL=postgresql://user:password@host:5432/database

# Supabase Auth; también puede definirse en el .env de la raíz con prefijo VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Puerto local del backend (opcional; por defecto 5000).
PORT=5000
